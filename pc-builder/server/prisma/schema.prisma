generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  CUSTOMER
  ADMIN
  SUPPORT
}

enum ProductKind {
  PREBUILD
  ACCESSORY
}

enum ConfigStatus {
  DRAFT
  SAVED
  SHARED
  ORDERED
  ARCHIVED
}

enum CartItemKind {
  PRODUCT
  CONFIGURATION
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PARTS_ORDERED
  ASSEMBLING
  TESTING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  TEST
  COD
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InventoryReason {
  SEED
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

model Role {
  id        String   @id @default(uuid())
  name      RoleName @unique
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]

  @@map("roles")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  mobile        String    @unique
  passwordHash  String    @map("password_hash")
  roleId        String    @map("role_id")
  role          Role      @relation(fields: [roleId], references: [id])
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  profile             UserProfile?
  refreshTokens       RefreshToken[]
  passwordResets      PasswordReset[]
  configurations      Configuration[]
  carts               Cart[]
  orders              Order[]
  addresses           Address[]
  tickets             SupportTicket[] @relation("TicketAuthor")
  assignedTickets     SupportTicket[] @relation("TicketAssignee")
  ticketMessages      SupportMessage[]
  reviews             Review[]
  wishlist            WishlistItem[]
  notifications       Notification[]
  couponsCreated      Coupon[]        @relation("CouponCreator")

  @@index([email])
  @@index([mobile])
  @@index([roleId])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  location  String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

model ProductCategory {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  kind      ProductKind
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("product_categories")
}

model Product {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  subtitle    String?
  description String
  kind        ProductKind
  categoryId  String          @map("category_id")
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  basePrice   Decimal         @map("base_price") @db.Decimal(12, 2)
  compareAt   Decimal?        @map("compare_at") @db.Decimal(12, 2)
  tier        String?
  purpose     String?
  warrantyOnsiteMonths Int    @default(3) @map("warranty_onsite_months")
  warrantyNote String?        @map("warranty_note")
  deliveryNote String?        @map("delivery_note")
  faq         Json?
  specs       Json?
  isPublished Boolean         @default(true) @map("is_published")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  images     ProductImage[]
  components ProductComponent[]
  inventory  Inventory[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlist   WishlistItem[]

  @@index([kind, isPublished])
  @@index([categoryId])
  @@index([basePrice])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

model ComponentCategory {
  id         String      @id @default(uuid())
  slug       String      @unique
  name       String
  stepOrder  Int         @map("step_order")
  required   Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")
  components Component[]

  @@map("component_categories")
}

model Component {
  id          String            @id @default(uuid())
  slug        String            @unique
  name        String
  brand       String
  categoryId  String            @map("category_id")
  category    ComponentCategory @relation(fields: [categoryId], references: [id])
  sku         String            @unique
  price       Decimal           @db.Decimal(12, 2)
  description String
  specs       Json
  wattageEst  Int               @default(0) @map("wattage_est")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  inventory          Inventory[]
  productLinks       ProductComponent[]
  configLinks        ConfigurationComponent[]
  compatibilityFrom  ComponentCompatibility[] @relation("CompatFrom")
  compatibilityTo    ComponentCompatibility[] @relation("CompatTo")

  @@index([categoryId, isActive])
  @@index([brand])
  @@map("components")
}

model ComponentCompatibility {
  id            String    @id @default(uuid())
  fromId        String    @map("from_component_id")
  toId          String    @map("to_component_id")
  from          Component @relation("CompatFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to            Component @relation("CompatTo", fields: [toId], references: [id], onDelete: Cascade)
  ruleKey       String    @map("rule_key")
  compatible    Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([fromId, toId, ruleKey])
  @@index([ruleKey])
  @@map("component_compatibility")
}

model ProductComponent {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  componentId String    @map("component_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  component   Component @relation(fields: [componentId], references: [id])
  quantity    Int       @default(1)
  label       String?

  @@unique([productId, componentId])
  @@map("product_components")
}

model Configuration {
  id          String       @id @default(uuid())
  userId      String?      @map("user_id")
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  shareToken  String?      @unique @map("share_token")
  status      ConfigStatus @default(DRAFT)
  notes       String?
  subtotal    Decimal      @default(0) @db.Decimal(12, 2)
  gstAmount   Decimal      @default(0) @map("gst_amount") @db.Decimal(12, 2)
  total       Decimal      @default(0) @db.Decimal(12, 2)
  valid       Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  parts      ConfigurationComponent[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([userId, status])
  @@map("configurations")
}

model ConfigurationComponent {
  id              String        @id @default(uuid())
  configurationId String        @map("configuration_id")
  componentId     String        @map("component_id")
  configuration   Configuration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  component       Component     @relation(fields: [componentId], references: [id])
  quantity        Int           @default(1)
  slot            String?

  @@unique([configurationId, componentId, slot])
  @@map("configuration_components")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  String?    @map("coupon_id")
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id              String         @id @default(uuid())
  cartId          String         @map("cart_id")
  cart            Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  kind            CartItemKind
  productId       String?        @map("product_id")
  product         Product?       @relation(fields: [productId], references: [id])
  configurationId String?        @map("configuration_id")
  configuration   Configuration? @relation(fields: [configurationId], references: [id])
  quantity        Int            @default(1)
  savedForLater   Boolean        @default(false) @map("saved_for_later")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([cartId])
  @@map("cart_items")
}

model Address {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  fullName   String   @map("full_name")
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String   @default("India")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  orders     Order[]

  @@index([userId])
  @@map("addresses")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id])
  addressId       String      @map("address_id")
  address         Address     @relation(fields: [addressId], references: [id])
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Decimal     @db.Decimal(12, 2)
  gstAmount       Decimal     @map("gst_amount") @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  deliveryFee     Decimal     @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  couponId        String?     @map("coupon_id")
  coupon          Coupon?     @relation(fields: [couponId], references: [id])
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  items    OrderItem[]
  history  OrderStatusHistory[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String         @map("order_id")
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind            CartItemKind
  productId       String?        @map("product_id")
  product         Product?       @relation(fields: [productId], references: [id])
  configurationId String?        @map("configuration_id")
  configuration   Configuration? @relation(fields: [configurationId], references: [id])
  name            String
  quantity        Int
  unitPrice       Decimal        @map("unit_price") @db.Decimal(12, 2)
  snapshot        Json

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  providerRef     String?       @map("provider_ref")
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payments")
}

model SupportTicket {
  id          String         @id @default(uuid())
  ticketNo    String         @unique @map("ticket_no")
  userId      String         @map("user_id")
  user        User           @relation("TicketAuthor", fields: [userId], references: [id])
  assigneeId  String?        @map("assignee_id")
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  category    String
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  messages    SupportMessage[]

  @@index([userId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String        @map("ticket_id")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id])
  body       String
  attachment String?
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  title     String
  body      String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("wishlist")
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  description   String
  percentOff    Int?     @map("percent_off")
  amountOff     Decimal? @map("amount_off") @db.Decimal(12, 2)
  minSubtotal   Decimal  @default(0) @map("min_subtotal") @db.Decimal(12, 2)
  active        Boolean  @default(true)
  expiresAt     DateTime? @map("expires_at")
  createdById   String?  @map("created_by")
  createdBy     User?    @relation("CouponCreator", fields: [createdById], references: [id])
  carts         Cart[]
  orders        Order[]
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("coupons")
}

model Inventory {
  id          String          @id @default(uuid())
  productId   String?         @map("product_id")
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  componentId String?         @map("component_id")
  component   Component?      @relation(fields: [componentId], references: [id], onDelete: Cascade)
  quantity    Int
  reserved    Int             @default(0)
  reason      InventoryReason @default(ADJUSTMENT)
  note        String?
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([productId])
  @@index([componentId])
  @@map("inventory")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model Lead {
  id        String   @id @default(uuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  mobile    String
  location  String
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leads")
}

model FaqItem {
  id        String   @id @default(uuid())
  question  String
  answer    String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("faq_items")
}

model GalleryItem {
  id        String   @id @default(uuid())
  kind      String
  title     String
  caption   String?
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("gallery_items")
}
