# Copy to pc-builder/.env and to server/.env as needed.
# Never commit real secrets.

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
API_PREFIX=/api

# PostgreSQL
DATABASE_URL=postgresql://aetherforge:aetherforge@localhost:5432/aetherforge?schema=public

# JWT — generate long random strings for production
JWT_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Admin seed only (used by prisma/seed.js — not hardcoded in app source)
ADMIN_EMAIL=admin@aetherforge.example
ADMIN_PASSWORD=change-me-in-local-env
ADMIN_FIRST_NAME=Aether
ADMIN_LAST_NAME=Admin

# Optional demo customer (seed only)
DEMO_EMAIL=aria@example.com
DEMO_PASSWORD=change-me-demo-user

# Mail — optional. In development, reset links are logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AetherForge <noreply@aetherforge.example>

# Payments: test | cod
PAYMENT_PROVIDER=test

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# GST (India)
GST_RATE=0.18
DELIVERY_FEE=0
